{
  "name": "next-up",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3030 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3030 --strictPort",
    "typecheck": "tsc -b && tsc -p tsconfig.worker.json",
    "lint": "eslint src shared worker tests",
    "test": "vitest run",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=.local/browsers playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:worker && npm run test:mcp && npm run test:database && npm run build",
    "worker:dev": "XDG_CONFIG_HOME=.local/config WRANGLER_LOG_PATH=.local/wrangler-logs WRANGLER_SEND_METRICS=false wrangler dev --port 8787",
    "format": "prettier --write src shared worker tests *.ts",
    "test:worker": "node scripts/check-worker.mjs",
    "test:pwa": "PLAYWRIGHT_BROWSERS_PATH=.local/browsers playwright test --config playwright.pwa.config.ts",
    "test:mcp": "node scripts/check-mcp.mjs",
    "test:database": "node scripts/check-database.mjs",
    "worker:types": "wrangler types worker/env.d.ts --env-interface WorkerBindings --include-runtime false --strict-vars false"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@supabase/supabase-js": "2.116.0",
    "@tabler/icons-react": "3.46.0",
    "@tailwindcss/vite": "4.3.3",
    "agents": "0.23.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "fast-xml-parser": "5.11.1",
    "jose": "6.2.1",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "vite-plugin-pwa": "1.3.0",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/workers-types": "5.20260910.1",
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "fake-indexeddb": "6.2.5",
    "globals": "17.12.0",
    "lighthouse": "13.4.1",
    "miniflare": "5.20260910.0-alpha",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "wrangler": "4.131.0"
  }
}
