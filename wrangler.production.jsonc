{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "next-up",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "APP_ORIGIN": "https://next-up.deivbid.workers.dev",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AUTH",
        "class_name": "IntegrationState",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["IntegrationState"],
    },
  ],
  "observability": {
    "enabled": false,
  },
}
